# --- SiteDig environment variables --------------------------------------
# Copy to `.env` next to docker-compose.yml (Portainer: use Environment vars
# on the stack) and adjust as needed.

# GHCR image + tag (public image).
SITEDIG_IMAGE=ghcr.io/bangsmackpow/sitedig
SITEDIG_TAG=latest

# Shared secret between the web service and the worker. REQUIRED: at least 32
# random characters, identical on both services. Generate one with:
#   openssl rand -base64 48
# The stack refuses to start when this is empty; internal endpoints never fail open.
SCAN_SERVICE_TOKEN=

# Web -> worker communication (Compose service name on the backend network).
WORKER_URL=http://worker:8081

# Logging verbosity: debug | info | warn | error | silent
LOG_LEVEL=info

# --- Deployment mode ------------------------------------------------------
# `hosted`     -> public multi-tenant SaaS (requires SMTP + Stripe below).
# `self-hosted`-> private/single-org install. The first admin is bootstrapped
#                 from INITIAL_ADMIN_* and can grant Premium to users without
#                 Stripe. Without SMTP, public registration is disabled (accounts
#                 are created by an admin); with SMTP, registration is available.
DEPLOYMENT_MODE=self-hosted

# SQLite database file for users, sessions, entitlements, and billing.
# Persist the parent directory (e.g. via a Compose volume) or this data is lost.
DATABASE_PATH=/data/sitedig.sqlite

# Public origin users are redirected to (checkout success, portal return, links).
APP_BASE_URL=http://localhost:3000

# --- First admin (self-hosted) -------------------------------------------
# Used ONLY when no admin exists yet. Safe to remove after first startup.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Email (Resend or SMTP) ------------------------------------------------
# Delivery provider: `resend` (default when RESEND_API_KEY is set) or `smtp`.
# Used for email verification, password reset, MFA codes, and the admin digest.
# Hosted mode requires email delivery. In self-hosted mode, SMTP/Resend is
# optional (accounts can be created by an admin, so no verification is needed).
EMAIL_PROVIDER=
# Resend API key (https://resend.com). Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# From address for all outbound email (must be a verified Resend domain or an SMTP-allowed sender).
EMAIL_FROM=

# SMTP alternative (used when EMAIL_PROVIDER=smtp or Resend is not configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Stripe (hosted billing) ----------------------------------------------
# Hosted mode requires all three. Self-hosted mode can leave Stripe unset and
# grant Premium via the admin console instead.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Annual Premium price (two months free). Required in hosted mode.
STRIPE_ANNUAL_PRICE_ID=price_xxx
# Where the Customer Portal returns users after billing management.
STRIPE_PORTAL_RETURN_URL=

# Paid-subscriber support contact. Shown only to Premium users on /support.
SUPPORT_EMAIL=

# --- Worker / scanner limits ---------------------------------------------
# Web service base URL the worker posts scan-history events to (Compose service
# name on the backend network). Leave empty to disable history callbacks.
WEB_BASE_URL=http://web:3000
# Maximum number of scans executing at once.
MAX_CONCURRENT_SCANS=1
# Maximum number of scans waiting in the queue (beyond concurrent scans).
MAX_QUEUE=3
# Per-scan cap in milliseconds (max 900000).
SCAN_TIMEOUT_MS=600000
# Maximum captured output per tool in bytes.
MAX_TOOL_OUTPUT_BYTES=20971520
# NEVER set to true on a public deployment. Allows RFC1918/private targets.
ALLOW_INTERNAL_TARGETS=false
# Where completed report artifacts live (deleted after download / TTL).
ARTIFACT_DIR=/tmp/sitedig-artifacts
# Minutes completed artifacts are kept before being swept.
ARTIFACT_TTL_MINUTES=30

# --- Paid add-on modules ------------------------------------------------
# Comma-separated module ids enabled on this deployment (the deployment
# ceiling). A user must ALSO hold Premium to run them. Set on BOTH the web and
# worker services. Leave empty to keep the detection-only free behavior.
#   asset-discovery        -> subfinder, dnsx, WHOIS (RDAP), email/DNS posture
#   vuln-scan              -> nuclei (curated templates), retire.js, httpx
#   tls-hardening          -> testssl.sh
#   content-discovery      -> feroxbuster, waybackurls
#   cve-context            -> OSV CVE enrichment
#   remediation-playbook   -> report-only per-finding fix plans + 30-day roadmap
#   web-trust              -> robots/sitemap/security.txt, page metadata, SRI/mixed content, HSTS/CSP/cookies
#   domain-hardening       -> CAA/SOA/SRV, DNSSEC, DKIM/BIMI, DMARC grading
#   infra-intel            -> IP geolocation, ASN/network, WAF/CDN fingerprinting
ENABLED_MODULES=

# DNS-over-HTTPS JSON endpoint used by domain-hardening for DNSSEC.
DOH_ENDPOINT=https://cloudflare-dns.com/dns-query
# No-key IP geolocation endpoint used by infra-intel ({ip} is appended).
IP_INTEL_ENDPOINT=https://ipwho.is

# --- Scan history & admin digest -----------------------------------------
# Days of scan history (metadata + finding counts; reports are never stored)
# to retain. 0 disables sweeping. Deleted automatically past this window.
SCAN_HISTORY_RETENTION_DAYS=365
# Maximum recurring scans a single Premium user may create.
MAX_SCHEDULES_PER_USER=10
# Send a daily email digest of new signups + scan activity to admins.
ADMIN_DIGEST_ENABLED=false
# UTC hour (0-23) after which the digest is sent once per day.
ADMIN_DIGEST_HOUR=8
# Comma-separated recipients. Leave empty to email every active admin account.
ADMIN_DIGEST_RECIPIENTS=

# Optional WPScan API token (vulnerability data for WP plugins/themes).
# Without it, wpscan runs local detection-only checks.
WPSCAN_API_TOKEN=

# Nuclei template allowlist (relative to NUCLEI_TEMPLATES_DIR, or absolute).
# Only these non-destructive templates will ever run.
NUCLEI_TEMPLATES=http/technologies/tech-detect.yaml,http/exposures/configs/git-config.yaml,ssl/tls-version.yaml,ssl/deprecated-tls.yaml,ssl/self-signed-ssl.yaml,ssl/expired-ssl.yaml,ssl/weak-cipher-suites.yaml
# Directory where nuclei templates were installed at image build time.
NUCLEI_TEMPLATES_DIR=/opt/nuclei-templates
# Wordlist used by content-discovery.
CONTENT_WORDLIST=/opt/sitedig/wordlists/common.txt
